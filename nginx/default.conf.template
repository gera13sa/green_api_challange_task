map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

server {
	listen ${PORT};
	server_name _;

	root /usr/share/nginx/html;
	index index.html;

	gzip on;
	gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
	gzip_static on;

	location / {
		try_files $uri $uri/ /index.html;
	}
}
